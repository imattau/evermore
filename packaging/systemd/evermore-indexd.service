[Unit]
Description=Evermore local semantic index
Documentation=https://github.com/imattau/evermore
After=default.target
# Enabled system-wide, so this also matches the greeter's own login (home
# "/", no enrolled identity). ProtectHome=read-only plus StateDirectory
# means the ExecStartPre chmod on %h/.local/state/evermore-indexd fails
# with Permission denied for that account, and the unit crash-loops every
# RestartSec forever. Gate on the same marker evermore-enroll creates for
# every real identity at account creation.
ConditionPathIsDirectory=%h/.local/share/evermore

[Service]
Type=simple
ExecStart=/usr/bin/evermore-indexd
ExecStartPre=/usr/bin/chmod 0700 %h/.local/state/evermore-indexd
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=evermore
RuntimeDirectoryMode=0700
StateDirectory=evermore-indexd
StateDirectoryMode=0700
Environment=EVERMORE_INDEX_STATE_DIR=%h/.local/state/evermore-indexd
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
