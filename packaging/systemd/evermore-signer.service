[Unit]
Description=Evermore Nostr signing daemon
Documentation=https://github.com/imattau/evermore
# Enabled system-wide, so this also matches the greeter's own login (home
# "/", no enrolled identity). Without this, ReadWritePaths=%h/.local/share/
# evermore below resolves to /.local/share/evermore, which never exists for
# that account, and the unit crash-loops (NAMESPACE failure) every
# RestartSec forever. evermore-enroll creates this directory for every real
# identity at account creation, so its absence means "not a real user yet".
ConditionPathIsDirectory=%h/.local/share/evermore

[Service]
Type=simple
# Installed system-wide by the Evermore package so a newly created homed
# account can start the signer before any per-user Rust toolchain exists.
# homed has unlocked and mounted this user's encrypted home before the user
# manager starts. Import the Nostr key into this login session's kernel
# keyring before serving requests; existing sessions without a home key keep
# their current behavior and can still load one explicitly.
ExecStartPre=/usr/bin/evermore-signer load-home-identity %u --if-present
# Idempotently create the built-in <owner>-operations and <owner>-assistant
# identities on first login (and after a home restore), before serve loads
# them. Existing keys are persisted, never replaced.
ExecStartPre=/usr/bin/evermore-signer ensure-service-identities %u
ExecStart=/usr/bin/evermore-signer serve
ExecStopPost=/usr/bin/evermore-signer unload-home-identity %u
Restart=on-failure
RestartSec=2

# The daemon's whole job is to be the one process that touches secret key
# material -- keep its own surface minimal.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Agent identities are persisted as 0600 files so they survive logout. The
# signer is the only process that writes them; Owner identity loading stays
# on the separate `load-home-identity` path. Also where the control socket
# (signer.sock) lives now -- NOT under $XDG_RUNTIME_DIR: RuntimeDirectory=
# under this sandboxing gives each unit its own private, invisible-to-
# everyone-else copy of %t/evermore, so no other process could ever reach
# this socket. See user_data_home() in evermore-common for the full story.
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true

[Install]
WantedBy=default.target
