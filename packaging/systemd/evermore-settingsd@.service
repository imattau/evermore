[Unit]
Description=Evermore settings daemon (NIP-78 sync over the control-plane relay)
Documentation=https://github.com/imattau/evermore
After=evermore-signer.service evermore-relay.service
Wants=evermore-signer.service evermore-relay.service

[Service]
Type=simple
# Assumes `evermore-npack install sh.evermore.settingsd` (or a dev-time
# `cargo build --release` + manual symlink) has put the binary at
# %h/.local/bin/. %i (systemd instance name) carries the identity to run
# as, so this is enabled per-identity: `systemctl --user enable evermore-settingsd@personal`.
ExecStart=%h/.local/bin/evermore-settingsd --identity %i
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true

[Install]
WantedBy=default.target
