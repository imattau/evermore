[Unit]
Description=Evermore Sway context bridge
After=default.target evermore-contextd.service

[Service]
Type=simple
ExecStart=/usr/bin/evermore-sway-ai-bridge
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=evermore
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
