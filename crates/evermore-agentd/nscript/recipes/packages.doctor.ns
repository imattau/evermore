// Prototype for Phase 12 / M12.3: can a real evermore-agentd recipe be
// authored as nscript source instead of hand-written TOML?
//
// This mirrors crates/evermore-agentd/recipes/packages.doctor.toml in full,
// now that `input` (added in this same change set) gives nscript a typed
// primitive for a form the host collects before running -- the gap
// nscript/README.md recorded when this prototype first shipped without a
// `choose` step. See that README for what else this does and does not
// prove (notably: nothing here is wired into evermore-agentd yet).
use evermore_packages

permissions {
    packages_read
    log
    clock
}

input publisher: Text
input name: Text

every 365d {
    let installed = evermore_packages.list_installed()?
    let dependencies = evermore_packages.explain_dependencies(publisher, name)?
    print(
        "Installed packages: " + text(installed.count) + "\n" +
        "Selected: " + publisher + "/" + name + " version " + dependencies.version
    )
}
