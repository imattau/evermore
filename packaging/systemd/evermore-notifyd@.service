[Unit]
Description=Evermore notification daemon (Nostr mentions/DMs + local events -> desktop toasts)
Documentation=https://github.com/imattau/evermore
After=evermore-signer.service evermore-relay.service evermore-settingsd@%i.service
Wants=evermore-signer.service evermore-relay.service

[Service]
Type=simple
# Per-identity instance, same convention as evermore-settingsd@.service:
# `systemctl --user enable evermore-notifyd@personal`.
ExecStart=/usr/bin/evermore-notifyd --identity %i
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Where the control socket (notifyd.sock) lives -- NOT under
# RuntimeDirectory=/$XDG_RUNTIME_DIR: that gives each sandboxed unit its
# own private, invisible-to-everyone-else runtime directory. See
# user_data_home() in evermore-common.
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true

[Install]
WantedBy=default.target
