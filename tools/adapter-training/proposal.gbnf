# GBNF grammar for one operation proposal or refusal.
# Use with llama-server's /v1/chat/completions "grammar" field.
root ::= proposal | refusal

proposal ::= "{\"operation\":\"" name "\",\"arguments\":" value "}"
refusal ::= "{\"refusal\":\"" text "\"}"

name ::= [a-z] [a-z0-9_.]*
value ::= object | array | string | number | "true" | "false" | "null"
object ::= "{" (string ":" value ("," string ":" value)*)? "}"
array ::= "[" (value ("," value)*)? "]"
string ::= "\"" char* "\""
char ::= [^"\\] | "\\" ["\\/bfnrt]
number ::= "-"? [0-9]+ ("." [0-9]+)?
text ::= [^"\\]*
