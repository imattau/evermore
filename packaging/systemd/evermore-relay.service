[Unit]
Description=Evermore local control-plane relay (khatru-based, loopback-only)
Documentation=https://github.com/imattau/evermore
# Enabled system-wide, so this also matches the greeter's own login (home
# "/", no enrolled identity). Without this, ReadWritePaths=%h/.local/share/
# evermore below resolves to /.local/share/evermore, which never exists for
# that account, and the unit crash-loops (NAMESPACE failure) every
# RestartSec forever. evermore-enroll creates this directory for every real
# identity at account creation, so its absence means "not a real user yet".
ConditionPathIsDirectory=%h/.local/share/evermore

[Service]
Type=simple
# The Evermore system install places the relay supervisor in /usr/bin.
ExecStart=/usr/bin/evermore-relay-supervisor
Restart=on-failure
RestartSec=2
Environment=EVERMORE_RELAY_PORT=4869

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true

[Install]
WantedBy=default.target
