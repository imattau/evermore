[Unit]
Description=Evermore Sway context bridge
After=default.target evermore-contextd.service

[Service]
Type=simple
ExecStart=/usr/bin/evermore-sway-ai-bridge
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
# Only ever connects to evermore-contextd's socket under
# %h/.local/share/evermore, never writes there, so the default read-only
# home bind from ProtectHome is enough -- no ReadWritePaths override.
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
