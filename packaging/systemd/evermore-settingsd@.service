[Unit]
Description=Evermore settings daemon (NIP-78 sync over the control-plane relay)
Documentation=https://github.com/imattau/evermore
After=evermore-signer.service evermore-relay.service
Wants=evermore-signer.service evermore-relay.service

[Service]
Type=simple
# The Evermore system install places binaries in /usr/bin. %i (the systemd
# instance name) carries the identity, so enable one instance per identity.
ExecStart=/usr/bin/evermore-settingsd --identity %i
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true

[Install]
WantedBy=default.target
