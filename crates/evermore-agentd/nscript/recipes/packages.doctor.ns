// title: Package doctor
// description: Inspect installed packages and explain one package's direct dependencies. Read-only.
//
// Mirrors crates/evermore-agentd/recipes/packages.doctor.toml, projected
// through crates/evermore-agentd/src/nscript_recipe.rs into the same
// Recipe/RecipeStep structs that file's loader validates and
// evermore-operationsd executes -- nscript's own runtime never runs here.
// See crates/evermore-agentd/nscript/README.md.
use evermore_packages

permissions {
    packages_read
    log
    clock
}

input publisher: Text
input name: Text

every 365d {
    let installed = evermore_packages.list_installed()?
    let dependencies = evermore_packages.explain_dependencies(publisher, name)?
    print(
        "Installed packages: " + text(installed.count) + "
" +
        "Selected: " + publisher + "/" + name + " version " + dependencies.version
    )
}
