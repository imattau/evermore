#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Select a file in Files and run 'Publish to Nostr'." >&2
  exit 2
fi
if [[ ! -f "$1" ]]; then
  echo "Select a file in Files and run 'Publish to Nostr'." >&2
  exit 2
fi
if [[ -z "${EVERMORE_BLOSSOM_URL:-}" ]]; then
  echo "Set EVERMORE_BLOSSOM_URL to your Blossom server URL." >&2
  exit 2
fi

exec evermore-blossom-fs \
  --identity "${EVERMORE_IDENTITY:-personal}" \
  --blossom-url "$EVERMORE_BLOSSOM_URL" \
  --relay "${EVERMORE_RELAY_URL:-ws://127.0.0.1:4869}" \
  --publish-file "$1"
