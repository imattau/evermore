[Unit]
Description=Evermore AI context service
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/evermore-contextd
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=evermore
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
