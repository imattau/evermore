[Unit]
Description=Evermore local inference service
After=default.target
# Enabled system-wide, so this also matches the greeter's own login (home
# "/", no enrolled identity). Without this, ReadWritePaths=%h/.local/share/
# evermore below resolves to /.local/share/evermore, which never exists for
# that account. evermore-enroll creates this directory for every real
# identity at account creation, so its absence means "not a real user yet".
ConditionPathIsDirectory=%h/.local/share/evermore

[Service]
Type=simple
ExecStart=/usr/bin/evermore-inferd
Restart=on-failure
RestartSec=3
Environment=EVERMORE_LLAMA_SERVER_BIN=/usr/bin/llama-server
Environment=EVERMORE_INFER_MAX_MODELS=2
Environment=EVERMORE_INFER_READY_TIMEOUT_SECS=120
UMask=0077
NoNewPrivileges=true
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
# Where the control socket (ai-inferd.sock) lives -- NOT under
# RuntimeDirectory=/$XDG_RUNTIME_DIR: that gives each sandboxed unit its
# own private, invisible-to-everyone-else runtime directory, so no other
# process (including the unsandboxed evermore-panel) could ever reach a
# socket bound there. See user_data_home() in evermore-common.
ReadWritePaths=%h/.local/share/evermore
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
